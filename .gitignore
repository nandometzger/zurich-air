# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Tooling
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Local configuration and secrets — never commit these
config.toml
.env
*.key
*.pem

# Generated previews (the README screenshot lives in docs/images/)
previews/*
!previews/.gitkeep

# Saved provider responses (real data: keep them out of the repository)
snapshots/

# Downloaded route files (routes.cache_dir)
cache/

# Notification files lgpio (gpiozero's pin library) creates in the working directory
.lgd-nfy*

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
