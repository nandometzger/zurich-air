# Zurich Air: systemd service template.
#
# scripts/install-pi.sh replaces @USER@ and @APP_DIR@ and installs the result as
# /etc/systemd/system/zurich-air.service. Change this template and re-run the installer
# rather than editing the installed copy; for local tweaks use `sudo systemctl edit zurich-air`.

[Unit]
Description=Zurich Air e-paper flight display
Documentation=https://github.com/nandometzger/zurich-air/blob/main/docs/raspberry-pi.md
# Start once the network is up. The app also rides out later outages on its own.
Wants=network-online.target
After=network-online.target
# Deliberately not ordered after time-sync.target (with systemd-time-wait-sync): while
# the network is down at boot the service would never start, and the panel would keep
# its last picture, live dot included. It starts at once and shows "WAITING FOR DATA";
# the app itself neither fetches nor draws while the clock reads a date before 2026.
# Crash-loop guard: at most 5 starts in 10 minutes. With the restart backoff below a
# crash loop stays under this limit and keeps retrying every 10 minutes; the limit only
# stops a fast loop if the backoff is unavailable (systemd older than 254).
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
# The app reports READY=1 once it has started, then WATCHDOG=1 after every update and at
# least once a minute while it waits for the next one (also during the 10-minute quiet
# hours interval). An update takes a minute at most (two 10 s source timeouts, DNS, the
# panel), so 5 minutes of silence means the process hangs: systemd kills and restarts it.
Type=notify
NotifyAccess=main
WatchdogSec=5min
User=@USER@
# On Raspberry Pi OS, /dev/spidev* belongs to group spi and /dev/gpiochip* to gpio.
SupplementaryGroups=spi gpio
# Must stay writable: config paths such as display.output_dir are relative to it, and
# lgpio (gpiozero's default pin library) writes .lgd-nfy* notification files here.
WorkingDirectory=@APP_DIR@
ExecStart=@APP_DIR@/.venv/bin/zurich-air run --config @APP_DIR@/config.toml
# Optional secrets such as ZURICH_AIR_ADSB_LOL_KEY (git-ignored; keep it chmod 600).
EnvironmentFile=-@APP_DIR@/.env
# Log lines reach the journal immediately: journalctl -u zurich-air
Environment=PYTHONUNBUFFERED=1
SyslogIdentifier=zurich-air

# Also after a watchdog timeout, or when the app exits because the display keeps failing.
Restart=always
RestartSec=30s
# Back off on repeated crashes: 30 s, 1 min, 2 min, 5 min, then every 10 min.
RestartSteps=4
RestartMaxDelaySec=10min

# Light hardening that leaves SPI and GPIO reachable.
NoNewPrivileges=yes
# /usr, /boot and /etc read-only; the home directory (and so @APP_DIR@) stays writable.
ProtectSystem=full
PrivateTmp=yes
ProtectControlGroups=yes
# The SPI driver is loaded at boot (dtparam=spi=on), never by the app.
ProtectKernelModules=yes
# Makes /sys read-only: loosen this if a display driver ever needs the legacy
# /sys/class/gpio interface (spidev, lgpio and gpiozero use /dev and do not).
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
# Deliberately absent:
#   PrivateDevices=, DevicePolicy=, DeviceAllow= and ProtectClock= (which implies
#   DeviceAllow=char-rtc and with it a device allow-list) would hide /dev/spidev* and
#   /dev/gpiochip* from the service.
#   ProtectHome= would make the application directory itself unreadable or read-only.
#   ProtectSystem=strict would need ReadWritePaths= for the working directory.

[Install]
WantedBy=multi-user.target
